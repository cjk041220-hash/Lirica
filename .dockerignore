# 排除不需要的文件和目录
.git/
.gitignore
.claude/
.idea/
.vscode/

# Python 虚拟环境
backend/.venv/
**/__pycache__/
**/*.py[cod]
**/.pytest_cache/

# 前端：node_modules 和旧产物不进构建上下文（镜像内重新 npm ci + build）
web/node_modules/
web/dist/
web/out/

# 运行时数据（通过 Docker volume 挂载）
backend/data/

# 敏感文件
backend/config/.env

# 文档（不需要进入镜像）
docs/
*.md
诊断.*
