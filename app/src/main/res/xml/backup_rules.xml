<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!-- Android <12 云备份排除规则：防止亲密记忆、自定义 Key 与崩溃日志随备份同步 -->
    <!-- 库名与 XiaoxiDatabase.DATABASE_NAME (lirica_aether.db) 保持一致 -->
    <exclude domain="database" path="lirica_aether.db" />
    <exclude domain="database" path="lirica_aether.db-shm" />
    <exclude domain="database" path="lirica_aether.db-wal" />
    <exclude domain="sharedpref" path="lirica_byok_prefs.xml" />
    <exclude domain="file" path="crashes" />
</full-backup-content>
