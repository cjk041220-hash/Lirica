<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 严防用户亲密双轨记忆库、BYOK 密钥与私密崩溃日志外流至云端备份 -->
        <!-- 库名与 LiricaDatabase.DATABASE_NAME (lirica_aether.db) 保持一致 -->
        <!-- domain + 相对 domain 的 path（Android 12+ data-extraction-rules 格式要求） -->
        <exclude domain="database" path="lirica_aether.db" />
        <exclude domain="database" path="lirica_aether.db-shm" />
        <exclude domain="database" path="lirica_aether.db-wal" />
        <exclude domain="sharedpref" path="lirica_byok_prefs.xml" />
        <exclude domain="file" path="crashes" />
    </cloud-backup>
    <device-to-device-transfer>
        <exclude domain="file" path="crashes" />
    </device-to-device-transfer>
</data-extraction-rules>
