# DeepSeek API Key (从 https://platform.deepseek.com/ 获取)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口地址（默认即可，注意必须以 /v1 结尾）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名（可选值：deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# 高德地图 — 需要「Web服务」类型的 Key（不是 Web端 JS API）
# 从 https://console.amap.com/ 获取
AMAP_API_KEY=xxxxxxxxxxxxxxxx

# Tavily 网络搜索（从 https://tavily.com/ 获取）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# API 认证 Token（部署到公网时务必设置；留空则不启用认证，仅限本地开发）
# 可自行生成一个随机字符串，例如: python -c "import secrets; print(secrets.token_hex(32))"
XIAOXI_API_TOKEN=

# CORS 允许的前端来源（逗号分隔，部署时改为实际域名）
CORS_ORIGINS=http://localhost:3000

# 是否信任反向代理的 X-Forwarded-For（限流 IP 归因）
# 仅在 Nginx/Caddy 等可信代理之后部署时设为 true；直连部署保持 false
TRUST_PROXY=false
