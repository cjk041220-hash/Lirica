# DeepSeek API Key (从 https://platform.deepseek.com/ 获取)
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# DeepSeek 接口地址（默认即可，注意必须以 /v1 结尾）
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# DeepSeek 模型名（可选值：deepseek-v4-flash / deepseek-v4-pro）
DEEPSEEK_MODEL=deepseek-v4-flash

# 高德地图 — 需要「Web服务」类型的 Key（不是 Web端 JS API）
# 从 https://console.amap.com/ 获取
AMAP_API_KEY=xxxxxxxxxxxxxxxx

# 谷歌地图（Places API New）— 港澳/海外 POI 搜索，与高德双引擎自动切换
# 从 https://console.cloud.google.com/ 获取（需启用 Places API (New)）
# 留空 = 优雅降级：港澳/海外地图查询回提示文案，不影响启动、不影响内地高德
# 每月 $200 免费额度覆盖个人用量
GOOGLE_MAPS_API_KEY=

# Tavily 网络搜索（从 https://tavily.com/ 获取）
TAVILY_API_KEY=tvly-xxxxxxxxxxxxxxxx

# API 认证 Token（部署到公网时务必设置；留空则不启用认证，仅限本地开发）
# 可自行生成一个随机字符串，例如: python -c "import secrets; print(secrets.token_hex(32))"
XIAOXI_API_TOKEN=

# CORS 允许的前端来源（逗号分隔，部署时改为实际域名）
CORS_ORIGINS=http://localhost:3000

# 是否信任反向代理的 X-Forwarded-For（限流 IP 归因）
# 仅在 Nginx/Caddy 等可信代理之后部署时设为 true；直连部署保持 false
TRUST_PROXY=false

# ── Web Push 推送通知（PWA） ──────────────────────────────────
# 生成方式：npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_MAILTO=mailto:xiaoxi@yinghai.local

# ── 隐私开关 ──────────────────────────────────────────────────
# 备份脱敏：设为 true 时备份剔除 cycle_records + 周期推算事件
# （events.source='cycle'）+ 对话档案（chat_sessions/chat_messages），
# 并 VACUUM 清页（DELETE 不清数据页原文，十六进制可捞回）
BACKUP_SCRUB_SENSITIVE=false

# 公网安全（fail-closed）：默认 false = 绑定非回环地址且未设
# XIAOXI_API_TOKEN 时**拒绝启动**（安全兜底）；
# 设为 true = 显式**允许**无 token 暴露到网络（仅启动告警）。
# true 是解除防护，不是加强防护——仅限受控内网临时调试，绝不用于公网。
XIAOXI_ALLOW_INSECURE=false
